{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Spooffit/docs-boilerplate/blob/main/schemas/docs-config.schema.json",
  "title": "Docs Boilerplate docs-config manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Name",
    "Description",
    "Profiles",
    "Skills",
    "Modules",
    "Site",
    "GeneratedFiles",
    "GeneratedHashes"
  ],
  "properties": {
    "Name": {
      "type": "string",
      "minLength": 1
    },
    "Description": {
      "type": "string",
      "minLength": 1
    },
    "Profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "Skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "Modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "Site": {
      "enum": [
        "docsify",
        "none"
      ]
    },
    "GeneratedFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:README\\.md|AGENTS\\.md|llms\\.txt|index\\.html|docs/(?:[a-z0-9-]+/)*[a-z0-9-]+\\.md|\\.agents/skills/[a-z0-9-]+/SKILL\\.md)$"
      }
    },
    "GeneratedHashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:README\\.md|AGENTS\\.md|llms\\.txt|index\\.html|docs/(?:[a-z0-9-]+/)*[a-z0-9-]+\\.md|\\.agents/skills/[a-z0-9-]+/SKILL\\.md)$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "RetiredFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:README\\.md|AGENTS\\.md|llms\\.txt|index\\.html|docs/(?:[a-z0-9-]+/)*[a-z0-9-]+\\.md|\\.agents/skills/[a-z0-9-]+/SKILL\\.md)$"
      }
    }
  }
}
