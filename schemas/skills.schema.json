{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Spooffit/docs-boilerplate/blob/main/schemas/skills.schema.json",
  "title": "Docs Boilerplate skills manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skills"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source",
          "destination"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*/SKILL\\.md$"
          },
          "destination": {
            "type": "string",
            "pattern": "^\\.agents/skills/[a-z0-9]+(?:-[a-z0-9]+)*/SKILL\\.md$"
          }
        }
      }
    }
  }
}
